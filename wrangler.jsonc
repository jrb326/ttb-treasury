{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treasury-labelcheck",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Turnstile widget domains + siteverify hostname allowlist (keep in sync:
  // wrangler turnstile widget update <sitekey> --domain <host> --json).
  "vars": {
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1,treasury-labelcheck.jrb326.workers.dev"
  }
}